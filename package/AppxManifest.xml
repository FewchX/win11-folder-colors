<?xml version="1.0" encoding="utf-8"?>
<!--
  Local (unsigned, Developer Mode) package that gives FolderColorMenu.dll an
  identity, which is what the Windows 11 context menu requires to show an
  IExplorerCommand handler. install.ps1 copies this next to FolderColor.exe
  in %LOCALAPPDATA%\Programs\FolderColors and registers it with
  Add-AppxPackage -Register (Windows refuses to register a loose package from
  some other folders, %LOCALAPPDATA%\FolderColors among them).
  The CLSID must match kClsidFolderColorMenu in src\FolderColorMenu.cpp.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop4 desktop5 desktop6 com rescap">

  <Identity Name="Local.FolderColors" Publisher="CN=FolderColors" Version="1.0.1.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Folder Colors</DisplayName>
    <PublisherDisplayName>personalisation</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- FolderColor.exe runs inside the package: keep its writes (colored.txt) real -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26300.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application Id="FolderColors" Executable="FolderColor.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Folder Colors"
        Description="Folder colors in the File Explorer context menu"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="Directory">
              <desktop5:Verb Id="FolderColor" Clsid="D29F5EDC-9191-4EB2-BCE9-7D761D399A80" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Folder Colors context menu">
              <com:Class Id="D29F5EDC-9191-4EB2-BCE9-7D761D399A80" Path="FolderColorMenu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
